        },
        "stage": {
          "const": "decision"
        },
        "rank_receipt_ref": {
          "type": "string",
          "minLength": 1
        },
        "c_execution_ref": {
          "type": "string",
          "minLength": 1
        },
        "match_id": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "object",
          "required": [
            "phase"
          ],
          "properties": {
            "phase": {
              "enum": [
                "prematch",
                "live"
              ]
            },
            "minute": {
              "type": "integer",
              "minimum": 0
            },
            "home_score": {
              "type": "integer",
              "minimum": 0
            },
            "away_score": {
              "type": "integer",
              "minimum": 0
            },
            "market_screenshot_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "c_decision": {
          "enum": [
            "ACT",
            "WAIT",
            "PASS"
          ]
        },
        "c_board_state": {
          "enum": [
            "FOCUS",
            "WATCH",
            "PASS"
          ]
        },
        "c_certified_burden": {
          "type": "number",
          "minimum": 0
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "invalidation_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "price_evidence_mode": {
          "enum": [
            "NONE",
            "USER_SCREENSHOT_ONLY",
            "EXECUTABLE_PREMATCH_QUOTE",
            "LIVE_COMPARISON_ONLY"
          ]
        },
        "wait_condition": {
          "type": "string",
          "minLength": 1
        },
        "reachability_basis": {
          "type": "string",
          "minLength": 1
        },
        "consistency_checks": {
          "type": "object",
          "required": [
            "same_authority_revision",
            "no_replacement_odds",
            "certificate_upgrade_guard_applied",
            "wait_reachability_checked",
            "no_retrospective_prematch_action",
            "market_disagreement_gate_applied"
          ],
          "properties": {
            "same_authority_revision": {
              "type": "boolean"
            },
            "no_replacement_odds": {
              "type": "boolean"
            },
            "certificate_upgrade_guard_applied": {
              "type": "boolean"
            },
            "wait_reachability_checked": {
              "type": "boolean"
            },
            "no_retrospective_prematch_action": {
              "type": "boolean"
            },
            "market_disagreement_gate_applied": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "route_owner": {
          "const": "FOM_WORK"
        },
        "market_disagreement_recheck_required": {
          "type": "boolean"
        },
        "market_disagreement_recheck_completed": {
          "type": "boolean"
        },
        "market_disagreement_recheck_basis": {
          "type": "string",
          "minLength": 1
        },
        "market_disagreement_recheck_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "c_decision": {
                "const": "WAIT"
              }
            },
            "required": [
              "c_decision"
            ]
          },
          "then": {
            "required": [
              "wait_condition",
              "reachability_basis"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "context": {
                "properties": {
                  "phase": {
                    "const": "live"
                  }
                },
                "required": [
                  "phase"
                ]
              }
            },
            "required": [
              "context"
            ]
          },
          "then": {
            "properties": {
              "context": {
                "required": [
                  "phase",
                  "minute",
                  "home_score",
                  "away_score"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "market_disagreement_recheck_required": {
                "const": true
              }
            },
            "required": [
              "market_disagreement_recheck_required"
            ]
          },
          "then": {
            "required": [
              "market_disagreement_recheck_basis",
              "market_disagreement_recheck_evidence_refs"
            ],
            "properties": {
              "market_disagreement_recheck_completed": {
                "const": true
              },
              "market_disagreement_recheck_evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
