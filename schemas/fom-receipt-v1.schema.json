{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FOM v1 Football C consistency receipt contracts",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "workflow_id",
        "run_id",
        "route_owner",
        "created_at",
        "stage",
        "evidence_refs",
        "football_c_authority",
        "requested_window",
        "native_receipt_status",
        "handoff_state",
        "eligible_match_ids",
        "pending_match_ids",
        "excluded_match_ids",
        "consistency_checks"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "pattern": "^FOMC-"
        },
        "run_id": {
          "type": "string",
          "pattern": "^FOMC-"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "football_c_authority": {
          "type": "object",
          "required": [
            "repository",
            "commit_sha",
            "active_model",
            "current_model_path",
            "stage_authority_path"
          ],
          "properties": {
            "repository": {
              "const": "acchtt/SlipTrace"
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "active_model": {
              "const": "C"
            },
            "current_model_path": {
              "const": "models/football/CURRENT_MODEL.md"
            },
            "stage_authority_path": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "schema_version": {
          "const": "fom-c-sweep-v1"
        },
        "stage": {
          "const": "sweep"
        },
        "requested_window": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        "native_receipt_ref": {
          "type": "string",
          "minLength": 1
        },
        "native_receipt_status": {
          "enum": [
            "V4_SWEEP_READY",
            "BLOCKED"
          ]
        },
        "eligible_match_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pending_match_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_match_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consistency_checks": {
          "type": "object",
          "required": [
            "complete_date_surface_contract_applied",
            "standing_exclusions_applied",
            "no_odds_or_lineup_blocker_added",
            "no_c_prediction_emitted"
          ],
          "properties": {
            "complete_date_surface_contract_applied": {
              "type": "boolean"
            },
            "standing_exclusions_applied": {
              "type": "boolean"
            },
            "no_odds_or_lineup_blocker_added": {
              "type": "boolean"
            },
            "no_c_prediction_emitted": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "route_owner": {
          "const": "FOM_WORK"
        },
        "blocker_code": {
          "enum": [
            "SOURCE_SURFACE_BLOCKED",
            "SOURCE_COMPLETENESS_FAILED",
            "NATIVE_EXECUTION_UNAVAILABLE"
          ]
        },
        "handoff_state": {
          "enum": [
            "RANK_READY",
            "RESEARCH_PENDING",
            "EMPTY_FINAL",
            "BLOCKED"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "native_receipt_status": {
                "const": "V4_SWEEP_READY"
              }
            },
            "required": [
              "native_receipt_status"
            ]
          },
          "then": {
            "required": [
              "native_receipt_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "native_receipt_status": {
                "const": "BLOCKED"
              }
            },
            "required": [
              "native_receipt_status"
            ]
          },
          "then": {
            "required": [
              "blocker_code"
            ]
          }
        }
      ]
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "workflow_id",
        "run_id",
        "route_owner",
        "created_at",
        "stage",
        "evidence_refs",
        "football_c_authority",
        "sweep_receipt_ref",
        "c_execution_ref",
        "assessed",
        "official_board",
        "consistency_checks"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "pattern": "^FOMC-"
        },
        "run_id": {
          "type": "string",
          "pattern": "^FOMC-"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "football_c_authority": {
          "type": "object",
          "required": [
            "repository",
            "commit_sha",
            "active_model",
            "current_model_path",
            "stage_authority_path"
          ],
          "properties": {
            "repository": {
              "const": "acchtt/SlipTrace"
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "active_model": {
              "const": "C"
            },
            "current_model_path": {
              "const": "models/football/CURRENT_MODEL.md"
            },
            "stage_authority_path": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "schema_version": {
          "const": "fom-c-rank-v1"
        },
        "stage": {
          "const": "rank"
        },
        "sweep_receipt_ref": {
          "type": "string",
          "minLength": 1
        },
        "c_execution_ref": {
          "type": "string",
          "minLength": 1
        },
        "assessed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "match_id",
              "c_board_state",
              "funded_certificate",
              "robustness",
              "evidence_refs"
            ],
            "properties": {
              "match_id": {
                "type": "string",
                "minLength": 1
              },
              "c_board_state": {
                "enum": [
                  "FOCUS",
                  "WATCH",
                  "PASS"
                ]
              },
              "funded_certificate": {
                "enum": [
                  "NONE",
                  "G3",
                  "G4",
                  "G5",
                  "G6"
                ]
              },
              "robustness": {
                "enum": [
                  "NONE",
                  "FRAGILE",
                  "CONDITIONAL",
                  "ROBUST"
                ]
              },
              "supported_line": {
                "type": "number",
                "minimum": 0
              },
              "follow_lane": {
                "enum": [
                  "FOLLOW",
                  "RESERVE",
                  "STOP"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "official_board": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consistency_checks": {
          "type": "object",
          "required": [
            "full_cohort_researched",
            "focus_only_board_admission",
            "no_fixed_numeric_cap",
            "price_blind_ranking",
            "same_authority_revision"
          ],
          "properties": {
            "full_cohort_researched": {
              "type": "boolean"
            },
            "focus_only_board_admission": {
              "type": "boolean"
            },
            "no_fixed_numeric_cap": {
              "type": "boolean"
            },
            "price_blind_ranking": {
              "type": "boolean"
            },
            "same_authority_revision": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "route_owner": {
          "const": "FOM_WORK"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "workflow_id",
        "run_id",
