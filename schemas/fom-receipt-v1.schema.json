        "price_evidence_mode",
        "market_disagreement_recheck_completed",
        "market_disagreement_recheck_required",
        "consistency_checks"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "pattern": "^FOMC-"
        },
        "run_id": {
          "type": "string",
          "pattern": "^FOMC-"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "football_c_authority": {
          "type": "object",
          "required": [
            "repository",
            "commit_sha",
            "active_model",
            "current_model_path",
            "stage_authority_path"
          ],
          "properties": {
            "repository": {
              "const": "acchtt/SlipTrace"
            },
            "commit_sha": {
              "type": "string",
